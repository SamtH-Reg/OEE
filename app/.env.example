# Cadena de conexión de Neon (endpoint directo, sin -pooler).
# Copiar este archivo a .env y completar. .env NO se versiona.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Token que usa la tablet. En producción: JWT de turno.
APP_TOKEN=demo

PORT=8787
